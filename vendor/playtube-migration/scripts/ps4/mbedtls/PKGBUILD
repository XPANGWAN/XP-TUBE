# Maintainer: cpasjuste <cpasjuste@gmail.com>

pkgname=ps4-openorbis-mbedtls
pkgver=3.6.7
pkgrel=2
pkgdesc='An open source, portable, easy to use, readable and flexible SSL library'
arch=('any')
url='https://tls.mbed.org'
license=('apache')
options=(!strip !debug libtool staticlibs)
depends=(ps4-openorbis-zlib)
makedepends=('ps4-openorbis-pkg-config' 'ps4-openorbis-vars')
source=("https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-${pkgver}/mbedtls-${pkgver}.tar.bz2")
groups=('ps4-openorbis-portlibs')
sha256sums=('a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6')

build() {
  cd mbedtls-$pkgver

  sed -i '/#if (defined(__FreeBSD__) || defined(__NetBSD__)) && !defined(HAVE_GETRANDOM)/s/$/ \&\& !defined(__PS4__)/' library/entropy_poll.c
  # the app and mpv run TLS handshakes on several threads at once: TLS 1.3 goes through PSA's global key store,
  # which is only safe with threading on (without it, concurrent first handshakes failed with "Generic error")
  sed -i 's|^//#define MBEDTLS_THREADING_C$|#define MBEDTLS_THREADING_C|; s|^//#define MBEDTLS_THREADING_PTHREAD$|#define MBEDTLS_THREADING_PTHREAD|' \
    include/mbedtls/mbedtls_config.h
  grep -q '^#define MBEDTLS_THREADING_C$' include/mbedtls/mbedtls_config.h
  grep -q '^#define MBEDTLS_THREADING_PTHREAD$' include/mbedtls/mbedtls_config.h

  source /opt/pacbrew/ps4/openorbis/ps4vars.sh

  mkdir -p build && cd build

  openorbis-cmake \
    -DCMAKE_INSTALL_PREFIX=${OPENORBIS}/usr \
    -DENABLE_TESTING=FALSE -DENABLE_PROGRAMS=FALSE \
    ..

  make -j$(nproc)

}

package() {
  cd mbedtls-$pkgver/build
  make install DESTDIR="$pkgdir"
}

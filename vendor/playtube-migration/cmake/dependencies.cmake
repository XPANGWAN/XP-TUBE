# System libraries: from pkg-config on Linux, from the OpenOrbis toolchain on PS4.
# PS4: always by name. pkg-config IMPORTED_TARGETs pass full paths, which lld records as the module to load
# (/opt/pacbrew/...) and the console cannot resolve (scripts/check-ps4-imports.sh).
add_library(playtube_sdl2 INTERFACE)
add_library(playtube_curl INTERFACE)
add_library(playtube_crypto INTERFACE)
add_library(playtube_mpv INTERFACE)
add_library(playtube_fribidi INTERFACE)  # right-to-left text (ui/bidi)
add_library(playtube_av INTERFACE)  # FFmpeg's WebP decoder for DeArrow's thumbnails (player/webp)
if(PLATFORM_PS4)
    pkg_check_modules(SDL2 REQUIRED sdl2)
    target_include_directories(playtube_sdl2 SYSTEM INTERFACE ${SDL2_INCLUDE_DIRS})
    target_link_directories(playtube_sdl2 INTERFACE ${SDL2_LIBRARY_DIRS})
    target_link_libraries(playtube_sdl2 INTERFACE ${SDL2_LIBRARIES})
    # system keyboard (UTF-16 dialog) and user service, by name
    target_link_libraries(playtube_sdl2 INTERFACE SceImeDialog SceCommonDialog SceSysmodule SceUserService)
    # static libcurl without a .pc file: its dependencies come from libcurl.la (mbed TLS, zlib, SceNet)
    target_include_directories(playtube_curl SYSTEM INTERFACE $ENV{OPENORBIS}/usr/include)
    target_link_directories(playtube_curl INTERFACE $ENV{OPENORBIS}/usr/lib)
    target_link_libraries(playtube_curl INTERFACE curl mbedtls mbedx509 mbedcrypto z SceNet)
    target_include_directories(playtube_crypto SYSTEM INTERFACE $ENV{OPENORBIS}/usr/include)
    target_link_directories(playtube_crypto INTERFACE $ENV{OPENORBIS}/usr/lib)
    target_link_libraries(playtube_crypto INTERFACE mbedx509 mbedcrypto)
    # static libmpv and what it was built with (mpv.pc's Libs.private), by name
    target_include_directories(playtube_mpv SYSTEM INTERFACE $ENV{OPENORBIS}/usr/include)
    target_link_directories(playtube_mpv INTERFACE $ENV{OPENORBIS}/usr/lib)
    target_link_libraries(playtube_mpv INTERFACE mpv avformat avfilter avcodec swscale swresample avutil dav1d ass
        harfbuzz fribidi freetype samplerate z mbedtls mbedx509 mbedcrypto SceAudioOut ScePad)
    # static FriBidi of the build image (also libass's), by name
    target_include_directories(playtube_fribidi SYSTEM INTERFACE $ENV{OPENORBIS}/usr/include/fribidi)
    target_link_directories(playtube_fribidi INTERFACE $ENV{OPENORBIS}/usr/lib)
    target_link_libraries(playtube_fribidi INTERFACE fribidi)
    # static FFmpeg, also libmpv's (its libraries come with playtube_mpv's list), by name
    target_include_directories(playtube_av SYSTEM INTERFACE $ENV{OPENORBIS}/usr/include)
    target_link_directories(playtube_av INTERFACE $ENV{OPENORBIS}/usr/lib)
    target_link_libraries(playtube_av INTERFACE avcodec swscale avutil)
else()
    pkg_check_modules(SDL2 REQUIRED IMPORTED_TARGET sdl2)
    target_link_libraries(playtube_sdl2 INTERFACE PkgConfig::SDL2)
    pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
    target_link_libraries(playtube_curl INTERFACE PkgConfig::CURL)
    pkg_check_modules(LIBCRYPTO REQUIRED IMPORTED_TARGET libcrypto)
    target_link_libraries(playtube_crypto INTERFACE PkgConfig::LIBCRYPTO)
    pkg_check_modules(FRIBIDI REQUIRED IMPORTED_TARGET fribidi)
    target_link_libraries(playtube_fribidi INTERFACE PkgConfig::FRIBIDI)
    pkg_check_modules(AV REQUIRED IMPORTED_TARGET libavcodec libswscale libavutil)
    target_link_libraries(playtube_av INTERFACE PkgConfig::AV)
    pkg_check_modules(MPV REQUIRED IMPORTED_TARGET mpv)
    target_link_libraries(playtube_mpv INTERFACE PkgConfig::MPV)
endif()
